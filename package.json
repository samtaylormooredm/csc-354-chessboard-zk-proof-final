{
  "name": "chess-puzzle-competition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run --config vitest.engine.config.ts",
    "build-puzzles": "tsx scripts/build-puzzles.ts",
    "verify": "tsx scripts/verify.ts",
    "engine:node-results": "tsx scripts/engine-node-results.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
